<div class="container py-4">
  <h2>Three+ Bedroom Properties</h2>
  <a href="/" class="btn btn-secondary mb-3">Back to all properties</a>

  <% if properties.empty? %>
    <p>No three bedroom or larger properties found.</p>
  <% else %>
    <div class="row">
      <% properties.each do |property| %>
        <div class="col-md-4 mb-4">
          <div class="card">
            <img src="<%= property['image_url'] %>" class="card-img-top" alt="<%= property['name'] %>">
            <div class="card-body">
              <h5 class="card-title"><%= property['name'] %></h5>
              <p class="card-text">Region: <%= property['region'] %></p>
              <p class="card-text">Bedrooms: <%= property['bedroom_no'] %></p>
              <p class="card-text">Price: $<%= property['price'] %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
